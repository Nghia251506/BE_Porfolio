# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=change_me_db_password

# ========== App ==========
PORT=5000
JWT_SECRET=change_me_base64_secret_at_least_32_bytes
JWT_EXPIRATION=86400000
# true khi chạy qua Cloudflare HTTPS (mặc định true)
JWT_COOKIE_SECURE=true

# ========== Cloudinary ==========
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# ========== GA4 (JSON credentials, 1 dòng) ==========
GA4_CREDENTIALS_JSON=

# ========== Cloudflare Tunnel ==========
# Zero Trust → Networks → Tunnels → Create → Docker → copy token
# Public Hostname: api.yourdomain.com → http://be:5000
CLOUDFLARE_TUNNEL_TOKEN=
