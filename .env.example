# ========== Aiven MySQL (copy từ Aiven Console → Connection information) ==========
DB_HOST=xxxxx.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# Aiven bắt buộc SSL
DB_SSL_MODE=REQUIRED

# ========== App ==========
PORT=5000
JWT_SECRET=change_me_base64_secret_at_least_32_bytes
JWT_EXPIRATION=86400000
JWT_COOKIE_SECURE=true

# ========== Cloudinary ==========
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# ========== GA4 (JSON credentials, 1 dòng) ==========
GA4_CREDENTIALS_JSON=

# ========== Cloudflare Tunnel ==========
# Public Hostname → http://be:5000
CLOUDFLARE_TUNNEL_TOKEN=
